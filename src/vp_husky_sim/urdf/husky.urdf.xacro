<?xml version="1.0"?>
<!--
  Clearpath Husky, ported for ROS 2 + new Gazebo (gz sim).

  Geometry, meshes and inertials are taken from the original ROS 1
  husky_description package. The classic-Gazebo / gazebo_ros_control
  plugins and transmissions have been replaced with gz-sim system
  plugins, mirroring the vp_car_sim setup so this robot spawns into the
  same gz-sim worlds and drives on the same /cmd_vel + /odom interface.
-->
<robot name="husky" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.14159265359"/>

  <!-- Base size (from husky_description) -->
  <xacro:property name="base_x_size" value="0.98740000"/>
  <xacro:property name="base_y_size" value="0.57090000"/>
  <xacro:property name="base_z_size" value="0.24750000"/>

  <!-- Wheel mounting positions -->
  <xacro:property name="wheelbase" value="0.5120"/>
  <xacro:property name="track" value="0.5708"/>
  <xacro:property name="wheel_vertical_offset" value="0.03282"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_length" value="0.1143"/>
  <xacro:property name="wheel_radius" value="0.1651"/>

  <!-- VisionPilot front camera spec (matches vp_car_sim):
       1x front-facing RGB camera, 50 deg HFOV, >=1MP. -->
  <xacro:property name="cam_hfov_deg" value="50.0"/>
  <xacro:property name="cam_width"  value="1280"/>
  <xacro:property name="cam_height" value="800"/>

  <!-- ============================================================ -->
  <!-- Base link: center of the robot's bottom plate                 -->
  <!-- ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z_size/4}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size/2}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${base_z_size*3/4-0.01}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size*4/5} ${base_y_size} ${base_z_size/2-0.02}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="46.034"/>
      <origin xyz="-0.00065 -0.085 0.062"/>
      <inertia ixx="0.6022" ixy="-0.02364" ixz="-0.1197"
               iyy="1.7386" iyz="-0.001544" izz="2.0296"/>
    </inertial>
  </link>

  <!-- Base footprint on the ground under the robot -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${wheel_vertical_offset - wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_footprint"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Decorations: top chassis, top plate, user rail, bumpers       -->
  <!-- ============================================================ -->
  <link name="top_chassis_link">
    <visual>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/top_chassis.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="top_chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_chassis_link"/>
    <origin xyz="0 0 0.225" rpy="0 0 0"/>
  </joint>

  <link name="top_plate_link">
    <visual>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/top_plate.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0.0812 0 0.245" rpy="0 0 0"/>
  </joint>

  <link name="user_rail_link">
    <visual>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/user_rail.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="user_rail_joint" type="fixed">
    <parent link="base_link"/>
    <child link="user_rail_link"/>
    <origin xyz="0.272 0 0.245" rpy="0 0 0"/>
  </joint>

  <link name="front_bumper_link">
    <visual>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/bumper.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.48 0 0.091" rpy="0 0 0"/>
  </joint>

  <link name="rear_bumper_link">
    <visual>
      <geometry>
        <mesh filename="package://vp_husky_sim/meshes/bumper.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="rear_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_bumper_link"/>
    <origin xyz="-0.48 0 0.091" rpy="0 0 ${M_PI}"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Wheels (4-wheel skid-steer)                                   -->
  <!-- ============================================================ -->
  <xacro:macro name="husky_wheel" params="wheel_prefix x y">
    <link name="${wheel_prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://vp_husky_sim/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.637"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.02467" ixy="0" ixz="0" iyy="0.04411" iyz="0" izz="0.02467"/>
      </inertial>
    </link>

    <joint name="${wheel_prefix}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_vertical_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- High-friction contact so skid-steering bites -->
    <gazebo reference="${wheel_prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:husky_wheel wheel_prefix="front_left"  x="${ wheelbase/2}" y="${ track/2}"/>
  <xacro:husky_wheel wheel_prefix="front_right" x="${ wheelbase/2}" y="${-track/2}"/>
  <xacro:husky_wheel wheel_prefix="rear_left"   x="${-wheelbase/2}" y="${ track/2}"/>
  <xacro:husky_wheel wheel_prefix="rear_right"  x="${-wheelbase/2}" y="${-track/2}"/>

  <!-- ============================================================ -->
  <!-- IMU link (frame only; sensor added below)                     -->
  <!-- ============================================================ -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.19 0 0.149" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ============================================================ -->
  <!-- GPS link (frame only; sensor added below)                     -->
  <!-- ============================================================ -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <origin xyz="0 0 0.245" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="gps_link"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Front-facing RGB camera (VisionPilot sensing module)          -->
  <!-- ============================================================ -->
  <link name="front_camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.06 0.03"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <!-- Mounted at the very front of the Husky (just ahead of the front bumper,
         above it), clear of the top-plate/sensor-arch structure, looking
         forward (+X) so it sees the road ahead.
         base_link front face is at x≈0.494 (base_x_size/2); 0.55 protrudes past it.
         Raised above the top_plate (z=0.245) for a higher, AWSIM-style vantage
         over the road. -->
    <origin xyz="0.55 0 0.45" rpy="0 0 0"/>
  </joint>

  <link name="front_camera_optical_link"/>
  <joint name="front_camera_optical_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_optical_link"/>
    <!-- REP-103 optical frame (no translation; the stray 1m offset was a bug). -->
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ============================================================ -->
  <!-- gz-sim system plugins                                         -->
  <!-- ============================================================ -->
  <gazebo>
    <!-- 4-wheel skid steer: two joints per side -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>imu/data</topic>
    </sensor>
  </gazebo>

  <!-- GPS sensor (NavSat: fed by the world's <spherical_coordinates> origin) -->
  <gazebo reference="gps_link">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>gps/fix</topic>
    </sensor>
  </gazebo>

  <!-- Front camera sensor -->
  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <camera>
        <horizontal_fov>${cam_hfov_deg * M_PI / 180.0}</horizontal_fov>
        <image>
          <width>${cam_width}</width>
          <height>${cam_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>300</far>
        </clip>
        <optical_frame_id>front_camera_optical_link</optical_frame_id>
        <camera_info_topic>husky/front_camera/camera_info</camera_info_topic>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>husky/front_camera/image_raw</topic>
    </sensor>
  </gazebo>

</robot>
