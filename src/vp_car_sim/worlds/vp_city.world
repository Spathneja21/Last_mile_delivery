<?xml version="1.0" ?>
<!--
  vp_city.world - lightweight urban world for VisionPilot SceneSeg.

  This is a self-contained gz-sim (new Gazebo) re-creation of the CitySim
  urban scene used by the ROS1/Gazebo-Classic `car-simulator` project. The
  original simple_city.world relies on a heightmap terrain plus ~550 online
  Gazebo-DB models and Gazebo-Classic-only plugins, none of which run under
  new Gazebo with software OpenGL. Here we keep the city *look* (terrain
  texture, road, lined buildings) using lightweight primitives for the bulk
  structure (road, sidewalks, buildings), so it still renders without a GPU.

  Terrain texture (city_terrain.jpg) is reused from car-simulator/citysim.

  Trees, parked vehicles and street furniture are real PBR-textured models
  pulled from the Gazebo Fuel library (https://app.gazebosim.org/fuel) via
  <include><uri>https://fuel.gazebosim.org/...</uri></include>. gz-sim
  downloads and caches each one under ~/.gz/fuel the first time this world
  is loaded — that first load needs internet access; every load after is
  served from the local cache. All referenced models are CC0 (OpenRobotics),
  no attribution required. Swapping primitives for these real meshes is a
  deliberate trade: better visual realism for SceneSeg/AutoDrive (closes
  some of the sim-to-real domain gap noted in HUSKY_PIPELINE.md) at the cost
  of more geometry/textures for the CPU software renderer to push per frame.
  If frame rate suffers, the cheapest props to drop first are the trees and
  street furniture (lamp posts, hydrant, dumpster) — the vehicles and signage
  matter most for SceneSeg's foreground-object class.
-->
<sdf version="1.9">
  <world name="vp_city">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.5 0.5 0.52 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>0.3</speed>
          <direction>0.5</direction>
          <humidity>0.4</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <fog>
        <color>0.75 0.82 0.88 1</color>
        <type>linear</type>
        <start>60</start>
        <end>260</end>
        <density>1.0</density>
      </fog>
    </scene>

    <!-- Key light: warm low-angle sun for well-defined shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.25 0.22 0.2 1</specular>
      <direction>-0.4 0.25 -0.8</direction>
    </light>

    <!-- Fill light: cool, no-shadow sky-bounce approximation so building/vehicle
         faces away from the sun aren't pure black (cheap stand-in for GI). -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.4 0.5 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.6 -0.3 -0.5</direction>
    </light>

    <!-- ===== Terrain (reuses CitySim city_terrain texture) ===== -->
    <model name="city_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.45 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>city_terrain.jpg</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Main road: a long asphalt strip down +X ===== -->
    <model name="main_road">
      <static>true</static>
      <pose>50 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>120 8 0.02</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.22 0.22 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>120 8 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Dashed centre line -->
    <model name="lane_markings">
      <static>true</static>
      <link name="link">
        <visual name="m0"><pose>5 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m1"><pose>12 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m2"><pose>19 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m3"><pose>26 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m4"><pose>33 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m5"><pose>40 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m6"><pose>47 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="m7"><pose>54 0 0.03 0 0 0</pose><geometry><box><size>2 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sidewalks -->
    <model name="sidewalk_left">
      <static>true</static>
      <pose>50 6 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>120 4 0.1</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>120 4 0.1</size></box></geometry></collision>
      </link>
    </model>
    <model name="sidewalk_right">
      <static>true</static>
      <pose>50 -6 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>120 4 0.1</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>120 4 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===== Buildings lining the street (foreground for SceneSeg) ===== -->
    <!-- Left side (y = +11) -->
    <model name="bldg_l0"><static>true</static><pose>12 12 6 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 12</size></box></geometry><material><ambient>0.50 0.42 0.35 1</ambient><diffuse>0.62 0.52 0.43 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 12</size></box></geometry></collision></link></model>
    <model name="bldg_l1"><static>true</static><pose>26 12 9 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 18</size></box></geometry><material><ambient>0.40 0.45 0.50 1</ambient><diffuse>0.50 0.56 0.62 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 18</size></box></geometry></collision></link></model>
    <model name="bldg_l2"><static>true</static><pose>40 12 7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 14</size></box></geometry><material><ambient>0.55 0.50 0.45 1</ambient><diffuse>0.66 0.60 0.54 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 14</size></box></geometry></collision></link></model>
    <model name="bldg_l3"><static>true</static><pose>54 12 11 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 22</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 22</size></box></geometry></collision></link></model>
    <model name="bldg_l4"><static>true</static><pose>68 12 8 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 16</size></box></geometry><material><ambient>0.52 0.44 0.38 1</ambient><diffuse>0.63 0.54 0.47 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 16</size></box></geometry></collision></link></model>
    <model name="bldg_l5"><static>true</static><pose>82 12 10 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 20</size></box></geometry><material><ambient>0.42 0.46 0.50 1</ambient><diffuse>0.52 0.57 0.62 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 20</size></box></geometry></collision></link></model>

    <!-- Right side (y = -11) -->
    <model name="bldg_r0"><static>true</static><pose>12 -12 8 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 16</size></box></geometry><material><ambient>0.46 0.40 0.36 1</ambient><diffuse>0.57 0.50 0.45 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 16</size></box></geometry></collision></link></model>
    <model name="bldg_r1"><static>true</static><pose>26 -12 11 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 22</size></box></geometry><material><ambient>0.43 0.47 0.51 1</ambient><diffuse>0.53 0.58 0.63 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 22</size></box></geometry></collision></link></model>
    <model name="bldg_r2"><static>true</static><pose>40 -12 7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 14</size></box></geometry><material><ambient>0.54 0.49 0.43 1</ambient><diffuse>0.65 0.59 0.52 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 14</size></box></geometry></collision></link></model>
    <model name="bldg_r3"><static>true</static><pose>54 -12 9 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 18</size></box></geometry><material><ambient>0.48 0.44 0.47 1</ambient><diffuse>0.58 0.54 0.57 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 18</size></box></geometry></collision></link></model>
    <model name="bldg_r4"><static>true</static><pose>68 -12 12 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 24</size></box></geometry><material><ambient>0.41 0.45 0.49 1</ambient><diffuse>0.51 0.56 0.61 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 24</size></box></geometry></collision></link></model>
    <model name="bldg_r5"><static>true</static><pose>82 -12 8 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>10 6 16</size></box></geometry><material><ambient>0.53 0.45 0.39 1</ambient><diffuse>0.64 0.55 0.48 1</diffuse></material></visual><collision name="c"><geometry><box><size>10 6 16</size></box></geometry></collision></link></model>

    <!-- ===== Parked / oncoming cars (foreground objects, real Fuel vehicle
         meshes with their own collision geometry — no extra <collision> needed).
         Each model's mesh is pre-rotated by its author to face +X at yaw=0. ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <name>car_1</name>
      <static>true</static>
      <pose>20 2.5 0.02 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>car_2</name>
      <static>true</static>
      <pose>45 -2.5 0.02 0 0 3.14159</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>car_3</name>
      <static>true</static>
      <pose>70 2.5 0.02 0 0 0</pose>
    </include>

    <!-- ===== A few street trees (real Fuel-hosted PBR models, fetched/cached
         from https://fuel.gazebosim.org on first load — requires internet
         once; cached under ~/.gz/fuel afterwards) ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_1</name>
      <static>true</static>
      <pose>33 8 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_2</name>
      <static>true</static>
      <pose>61 -8 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_3</name>
      <static>true</static>
      <pose>90 8 0 0 0 0</pose>
    </include>

    <!-- ===== Street furniture / clutter (real Fuel models) — adds the small
         foreground-object variety (signage, hydrants, work-zone gear) that
         SceneSeg/AutoDrive see in real driving footage but never saw in the
         flat-primitive city. ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Stop Sign</uri>
      <name>stop_sign_1</name>
      <static>true</static>
      <pose>4 8.3 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
      <name>fire_hydrant_1</name>
      <static>true</static>
      <pose>20 8.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dumpster</uri>
      <name>dumpster_1</name>
      <static>true</static>
      <pose>33 -8.3 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <name>lamp_post_1</name>
      <static>true</static>
      <pose>47 8.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <name>lamp_post_2</name>
      <static>true</static>
      <pose>75 -8.3 0 0 0 0</pose>
    </include>

    <!-- Small work-zone: a lane-closure cluster on the road shoulder -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_1</name>
      <static>true</static>
      <pose>57 3.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_2</name>
      <static>true</static>
      <pose>58.5 3.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_3</name>
      <static>true</static>
      <pose>60 3.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>jersey_barrier_1</name>
      <static>true</static>
      <pose>62 3.3 0 0 0 0</pose>
    </include>

  </world>
</sdf>
